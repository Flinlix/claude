{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/check-gate.sh\" mark"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/check-gate.sh\" satisfied"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/check-gate.sh\" reset"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "m=$(jq -r '.message // \"Claude needs your attention\"'); terminal-notifier -title \"🔔 Claude Code\" -message \"$m\" -activate com.anthropic.claudefordesktop 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "verdict=$(\"$HOME/.claude/hooks/check-gate.sh\" gate); if [ -n \"$verdict\" ]; then printf '%s\\n' \"$verdict\"; else { printf '\\a' > /dev/tty; } 2>/dev/null; terminal-notifier -title \"✅ Claude Code\" -message \"Task completed\" -activate com.anthropic.claudefordesktop >/dev/null 2>&1; echo '{\"systemMessage\":\"Claude is done\"}'; fi"
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true
}
